# Порт HTTP-сервера
PORT=4000

# SQLite: DATABASE_URL или DB_PATH
DATABASE_URL=sqlite:./aurora.db

# Каталоги библиотеки через запятую; фильм/сериал определяется сканером по содержимому
MEDIA_PATHS=/media

# Ключ подписи токенов. Пусто — сгенерируется и сохранится в файл jwt_secret рядом с БД
JWT_SECRET=

# Из локальной сети (192.168.x.x, 10.x.x.x и т.п.) всё доступно без входа — под первым
# пользователем; снаружи нужен вход. true — вход нужен всегда. Обязательно true за
# reverse proxy на том же хосте: там все клиенты выглядят как 127.0.0.1
STRICT_AUTH=false

LOG_LEVEL=info

# TMDB v3 key; без него обложки отключены и UI рисует плейсхолдеры
TMDB_API_KEY=
TMDB_LANGUAGE=ru-RU

# Постеры/бэкдропы кэшируются в <CACHE_DIR>/images
CACHE_DIR=./cache
